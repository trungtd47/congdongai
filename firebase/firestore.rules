rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function isSelf(uid) { return signedIn() && request.auth.uid == uid; }
    function changesOnly(fields) { return request.resource.data.diff(resource.data).affectedKeys().hasOnly(fields); }
    function validBody() { return request.resource.data.body is string && request.resource.data.body.size() > 0 && request.resource.data.body.size() <= 20000; }
    function voteToggle() {
      let old = resource.data.upvoterUids;
      let next = request.resource.data.upvoterUids;
      let uid = request.auth.uid;
      return changesOnly(['upvotes', 'upvoterUids'])
        && old is list && next is list
        && next.size() == next.toSet().size()
        && request.resource.data.upvotes is int
        && request.resource.data.upvotes >= 0
        && ((!(uid in old) && uid in next && next.size() == old.size() + 1
            && next.toSet().difference(old.toSet()) == [uid].toSet()
            && old.toSet().difference(next.toSet()).size() == 0
            && request.resource.data.upvotes == resource.data.upvotes + 1)
          || (uid in old && !(uid in next) && next.size() == old.size() - 1
            && old.toSet().difference(next.toSet()) == [uid].toSet()
            && next.toSet().difference(old.toSet()).size() == 0
            && request.resource.data.upvotes == resource.data.upvotes - 1));
    }
    match /users/{uid} {
      allow read: if true;
      allow create: if isSelf(uid) && request.resource.data.role == 'member';
      allow update: if isSelf(uid) && changesOnly(['displayName','photoURL','updatedAt'])
        && request.resource.data.role == resource.data.role;
      allow delete: if false;
    }
    match /posts/{postId} {
      function countNewAnswer() {
        let answerId = request.resource.data.lastAnswerId;
        let answerPath = /databases/$(database)/documents/posts/$(postId)/answers/$(answerId);
        return changesOnly(['answerCount','lastAnswerId']) && answerId is string
          && request.resource.data.answerCount == resource.data.answerCount + 1
          && !exists(answerPath)
          && getAfter(answerPath).data.authorUid == request.auth.uid;
      }
      function acceptSelection() {
        let answerId = request.resource.data.solvedAnswerId;
        let oldId = resource.data.solvedAnswerId;
        return isSelf(resource.data.authorUid) && changesOnly(['solvedAnswerId'])
          && answerId is string
          && getAfter(/databases/$(database)/documents/posts/$(postId)/answers/$(answerId)).data.isAccepted == true
          && (oldId == null || oldId == answerId
            || getAfter(/databases/$(database)/documents/posts/$(postId)/answers/$(oldId)).data.isAccepted == false);
      }
      allow read: if true;
      allow create: if signedIn() && request.resource.data.authorUid == request.auth.uid
        && request.resource.data.flagged == false && request.resource.data.solvedAnswerId == null
        && request.resource.data.answerCount == 0 && request.resource.data.upvotes == 0
        && request.resource.data.upvoterUids == [] && validBody()
        && request.resource.data.title is string && request.resource.data.title.size() > 0
        && request.resource.data.title.size() <= 300;
      allow update: if signedIn() && (
        (isSelf(resource.data.authorUid) && changesOnly(['title','body','tags','imageURL']) && validBody())
        || voteToggle() || countNewAnswer() || acceptSelection());
      allow delete: if isSelf(resource.data.authorUid);
      match /answers/{answerId} {
        function parentAfter() { return getAfter(/databases/$(database)/documents/posts/$(postId)).data; }
        allow read: if true;
        allow create: if signedIn() && request.resource.data.authorUid == request.auth.uid
          && request.resource.data.isAI == false && request.resource.data.isAccepted == false
          && request.resource.data.flagged == false && request.resource.data.upvotes == 0
          && request.resource.data.upvoterUids == [] && validBody()
          && parentAfter().lastAnswerId == answerId
          && parentAfter().answerCount == get(/databases/$(database)/documents/posts/$(postId)).data.answerCount + 1;
        allow update: if signedIn() && (
          (isSelf(resource.data.authorUid) && resource.data.isAI == false
            && changesOnly(['body','imageURL']) && validBody())
          || voteToggle()
          || (isSelf(get(/databases/$(database)/documents/posts/$(postId)).data.authorUid)
            && changesOnly(['isAccepted']) && request.resource.data.isAccepted is bool
            && request.resource.data.isAccepted == (parentAfter().solvedAnswerId == answerId)));
        allow delete: if false;
      }
    }
    match /articles/{slug}/comments/{cid} {
      allow read: if true;
      allow create: if signedIn() && request.resource.data.authorUid == request.auth.uid
        && request.resource.data.isAI == false && request.resource.data.flagged == false && validBody();
      allow update: if isSelf(resource.data.authorUid) && resource.data.isAI == false
        && changesOnly(['body','imageURL']) && validBody();
      allow delete: if isSelf(resource.data.authorUid) && resource.data.isAI == false;
    }
    match /notifications/{docId} {
      allow read, delete: if signedIn() && docId.matches(request.auth.uid + '_.*');
      allow create, update: if false;
    }
    match /flags/{fid} {
      allow read: if false;
      allow create: if signedIn() && request.resource.data.reporterUid == request.auth.uid && request.resource.data.status == 'open';
      allow update, delete: if false;
    }
    match /{document=**} { allow read, write: if false; }
  }
}
