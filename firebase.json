{
  "firestore": {
    "databases": {
      "congdongai": {
        "rules": "firestore/firestore.rules"
      }
    }
  },
  "storage": {
    "rules": "firebase/storage.rules"
  },
  "hosting": {
    "public": "out",
    "ignore": ["firebase.json", "**/.*", "**/node_modules/**"],
    "rewrites": [
      {
        "source": "**",
        "destination": "/index.html"
      }
    ],
    "cleanUrls": true,
    "trailingSlash": true
  }
}